# Personalas — environment variable template.
#
# Copy to `.env` or `.env.local` for local dev and fill in real values.
# Both `.env` and `.env.local` are gitignored. NEVER commit real secrets.
# Production / Preview: set these in Vercel Project → Settings → Environment Variables.
# Stripe Payment Link URLs live in config/sot.json (not here). Full reference: DEPLOYMENT.md.

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_BEGINNER_PDF=price_REPLACE_ME_BEGINNER
STRIPE_PRICE_ADVANCED_PDF=price_REPLACE_ME_ADVANCED
STRIPE_PRICE_BUNDLE_PDF=price_REPLACE_ME_BUNDLE

# ---- Download token signing ----
# Long random string. Generate with: openssl rand -base64 48
DOWNLOAD_TOKEN_SECRET=REPLACE_ME_LONG_RANDOM_VALUE

# ---- Resend (transactional email) ----
RESEND_API_KEY=re_REPLACE_ME
FULFILLMENT_FROM_EMAIL=Prompt Anatomy <hello@promptanatomy.help>

# Optional: Plausible analytics domain (inject at build: PUBLIC_ANALYTICS_DOMAIN=promptanatomy.help)
# PUBLIC_ANALYTICS_DOMAIN=

# ---- Upstash Redis (fulfillment state, idempotency, token jti) ----
UPSTASH_REDIS_REST_URL=https://REPLACE_ME.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME
# Optional when sharing one Upstash DB with another app (keys become personalas:fulfillment:...)
REDIS_KEY_PREFIX=personalas:

# ---- Site ----
# Canonical site URL for emailed / in-page download links.
# REQUIRED in Vercel Production (VERCEL_ENV=production) — fulfillment fails closed without it.
SITE_URL=https://www.promptanatomy.help

# ---- Private PDF source (Vercel Blob recommended) ----
# 1. Vercel Dashboard → Storage → Blob (Private store) → BLOB_READ_WRITE_TOKEN (auto)
# 2. Local: npm run pdf:export && npm run pdf:upload:blob  → paste URLs below + into Vercel env
# Fulfillment auto-sends Bearer BLOB_READ_WRITE_TOKEN for *.blob.vercel-storage.com URLs.
BLOB_READ_WRITE_TOKEN=
PDF_BEGINNER_SOURCE_URL=https://REPLACE_ME.private.blob.vercel-storage.com/prompt-anatomy/pdfs/beginner-guide.pdf
PDF_ADVANCED_SOURCE_URL=https://REPLACE_ME.private.blob.vercel-storage.com/prompt-anatomy/pdfs/advanced-guide.pdf

# Optional: bearer token if PDF host is not Vercel Blob (overrides auto Blob auth).
# PDF_SOURCE_AUTH_TOKEN=

# Optional: custom header for the PDF source, format `Header-Name: value`.
# PDF_SOURCE_AUTH_HEADER=X-Auth-Token: REPLACE_ME

# ---- Optional TTL overrides ----
# DOWNLOAD_TOKEN_TTL_SECONDS=604800           # 7 days
# IN_PAGE_DOWNLOAD_TOKEN_TTL_SECONDS=900      # 15 minutes
# FULFILLMENT_STATE_TTL_SECONDS=7776000       # 90 days

# ---- Optional: rotate the CAN-SPAM postal address without a redeploy ----
# Defaults to config/sot.json → product.businessAddress. Provide a JSON object
# with the same keys to override (e.g. when the virtual mailbox changes).
# BUSINESS_ADDRESS_OVERRIDE={"name":"Prompt Anatomy","street":"1311 Park St","unit":"Unit #654","city":"Alameda","region":"CA","postalCode":"94501","country":"US","countryName":"United States"}
