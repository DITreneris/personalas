{
  "name": "personalas",
  "version": "1.5.1",
  "private": true,
  "description": "Personalas – US-localized HR hiring prompts, static HTML site",
  "repository": {
    "type": "git",
    "url": "https://github.com/DITreneris/personalas.git"
  },
  "scripts": {
    "build": "node scripts/build-locale-pages.js",
    "generate:og": "node scripts/generate-og-image.js",
    "generate:community-illustration": "node scripts/optimize-community-illustration.js",
    "generate:favicon": "node scripts/generate-favicon-assets.js",
    "test": "npm run build && npm run pdf:validate && node tests/structure.test.js && npm run lint:html && npm run lint:html:privacy && npm run lint:html:locales && npm run lint:html:static && npm run lint:js",
    "test:structure": "node tests/structure.test.js",
    "lint:html": "npx html-validator-cli --file index.html --validator=https://html5.validator.nu/",
    "lint:html:privacy": "npx html-validator-cli --file privacy.html --validator=https://html5.validator.nu/",
    "lint:html:locales": "npx html-validator-cli --file en/index.html --validator=https://html5.validator.nu/ && npx html-validator-cli --file en/privacy.html --validator=https://html5.validator.nu/",
    "lint:html:static": "npx html-validator-cli --file success.html --validator=https://html5.validator.nu/ && npx html-validator-cli --file terms.html --validator=https://html5.validator.nu/",
    "lint:js": "eslint . --ext .js",
    "pdf:validate": "node scripts/build-pdf-html.js",
    "pdf:export": "node scripts/export-pdf-from-html.js",
    "pdf:covers": "node scripts/verify-pdf-cover.js",
    "pdf:covers:preview": "node scripts/verify-pdf-cover.js --preview",
    "pdf:placeholders": "node scripts/generate-pdf-cover-placeholders.js",
    "pdf:fonts": "node scripts/fetch-pdf-fonts.js",
    "pdf:upload:blob": "node scripts/upload-pdfs-to-vercel-blob.js",
    "seo:indexnow": "node scripts/indexnow-ping.js",
    "seo:indexnow:diff": "node scripts/indexnow-ping.js --since-head"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.3",
    "@vercel/blob": "^2.4.0",
    "resend": "^4.0.1",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "eslint": "^8.57.0",
    "html-validator-cli": "^7.0.0",
    "pa11y": "^6.2.3",
    "serve": "^14.2.1",
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5",
    "wait-on": "^8.0.1"
  }
}
