# Exclude files that are NOT needed during `npm test` on Vercel.
# .vercelignore is applied BEFORE the build — ignoring scripts/docs/tests/templates
# breaks `npm run build` / pdf:validate / structure tests.
# Those trees stay in the upload; vercel.json 404s hide them from the public CDN.
# Do NOT ignore api/**/*.js, config/sot.json, or .eslintrc.json.

.github/
.cursorrules
.pa11yrc.json
google-apps-script.js
*.md
